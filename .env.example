# Copy to .env and fill in. NEVER commit .env, never paste keys into screenshots/issues.

# --- LLM (course OpenRouter key is the default; only course-approved open models) ---
LLM_PROVIDER=openrouter          # openrouter | deepseek | glm | gemini | custom | fake
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat # must be a model enabled for the group's key
# LLM_BASE_URL=                  # only for LLM_PROVIDER=custom
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=60

# --- Steam ---
STEAM_API_KEY=                   # https://steamcommunity.com/dev/apikey (only needed for library import)
STEAM_CC=us
STEAM_LANG=english
STEAM_MIN_INTERVAL_S=1.5         # throttle for store endpoints

# --- App ---
GAMEGENE_DATA_DIR=data/store     # JSON store root
GAMEGENE_CATALOG=fixture         # fixture = bundled synthetic sample catalog | store = data/store/catalog
GAMEGENE_SERVICE=demo            # demo = built-in reference stub | real = Dev B implementation
